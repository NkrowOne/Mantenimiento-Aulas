# ─────────────────────────────────────────────────────────────────────────
# Configuración del despliegue.
#
#   cp .env.example .env
#   npx tsx scripts/gen-keys.ts     # genera secretos y claves; pégalos aquí
#   ./scripts/deploy.sh
#
# Están las 8 variables que el código lee de verdad, más las del despliegue.
# `scripts/deploy.sh` comprueba que no falte ninguna antes de levantar nada.
# ─────────────────────────────────────────────────────────────────────────

# ── Dominio y certificado ────────────────────────────────────────────────
# El nombre con el que los técnicos abren la aplicación. Su registro A debe
# existir SOLO en el resolver interno o el DNS de la VPN, nunca en el DNS
# público: publicar una IP privada filtra topología y hace que los resolvers
# con protección anti DNS-rebinding descarten la respuesta.
DOMAIN=aulas.tudominio.es
ACME_EMAIL=sistemas@tudominio.es

# Token de Cloudflare con permiso mínimo: Zone:DNS:Edit sobre esa única zona.
# Se usa para el reto DNS-01, que no necesita que el servidor sea alcanzable
# desde Internet.
CLOUDFLARE_API_TOKEN=

# ── Secretos (los genera scripts/gen-keys.ts) ────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REPORTS_WORKER_TOKEN=

# ── Front (se compilan dentro del bundle; ambas son públicas por diseño) ──
VITE_SUPABASE_URL=https://aulas.tudominio.es
VITE_SUPABASE_ANON_KEY=

# Minutos de inactividad antes de volver a pedir el PIN.
#
# 0 = nunca: la sesión dura hasta que alguien pulsa «Cerrar sesión». Es el
# comportamiento por defecto y el que menos estorba en el trabajo diario.
#
# A cambio, con la sesión abierta quien coja el dispositivo entra directamente:
# el PIN solo protege a partir de que alguien cierra sesión. Si los iPads se
# comparten entre turnos o salen del campus, pon 480 (una jornada).
VITE_LOCK_AFTER_MINUTES=0

# ── Análisis de los informes con IA (opcional) ────────────────────────────
# Sin clave, el informe se emite igual: el análisis se calcula a partir de los
# datos con reglas deterministas. Con clave, lo redacta Gemini razonando antes
# de escribir — las cifras se siguen calculando con SQL, el modelo solo escribe
# el texto.
#
# Se saca en https://aistudio.google.com/apikey. Es de pago por uso: un informe
# semanal cuesta céntimos, pero es una clave con factura, así que trátala como
# un secreto y no la pongas en el front.
#
# Alternativa sin reconstruir el contenedor: un administrador puede pegarla
# desde la pantalla de Informes, y se guarda en `app_config`. Si están las dos,
# manda esta.
GEMINI_API_KEY=

# El modelo y cuánto se le deja pensar. Los valores de abajo son los que se usan
# si no se dice nada; se pueden cambiar también desde la pantalla de Informes.
#   thinking: minimal | low | medium | high
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING=high

# ── Solo para ejecutar scripts desde el servidor ──────────────────────────
# `admin-user.ts` necesita estas dos. SUPABASE_SERVICE_ROLE_KEY se salta RLS
# por completo: trátala como la contraseña de root y no la pongas nunca en el
# front ni en un commit.
SUPABASE_URL=https://aulas.tudominio.es
SUPABASE_SERVICE_ROLE_KEY=

# Para el importador del Excel y las copias de seguridad.
DATABASE_URL=postgresql://postgres:CONTRASEÑA@localhost:5432/postgres

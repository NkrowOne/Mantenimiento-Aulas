# Copia este fichero a .env y ajusta los valores antes de levantar
# la infraestructura local con `docker compose up`.
# .env nunca se sube al repositorio ni a la imagen Docker.

# General
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=changeme-genera-un-secreto-aleatorio

# PostgreSQL
POSTGRES_DB=mantenimiento_aulas
POSTGRES_USER=mantenimiento
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://mantenimiento:changeme@postgres:5432/mantenimiento_aulas

# MinIO (almacenamiento S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mantenimiento-aulas
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme123

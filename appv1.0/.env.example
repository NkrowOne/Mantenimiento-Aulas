# Copia este fichero a .env y ajusta los valores antes de levantar
# la infraestructura local con `docker compose up`.
# .env nunca se sube al repositorio ni a la imagen Docker.
#
# Todas las variables que lee la aplicación (proceso Next.js) se validan
# de forma centralizada en `src/lib/env.ts` con Zod. Si falta alguna
# obligatoria, la app falla al arrancar con un mensaje explicando cuál.

# General
NODE_ENV=development
AUTH_SECRET=changeme-genera-un-secreto-aleatorio

# Pública: se expone al navegador (prefijo NEXT_PUBLIC_), no es secreta.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
# POSTGRES_DB/USER/PASSWORD solo los usa el contenedor de postgres para
# inicializar la base de datos (rol superusuario); la app en tiempo de
# ejecución NO se conecta con él, ver APP_DATABASE_URL más abajo.
#
# DATABASE_URL usa aquí "localhost" a propósito: este valor lo usan las
# herramientas que se ejecutan en tu máquina (drizzle-kit, `npm run
# db:seed`, `npm run dev`) contra el PostgreSQL publicado en el puerto
# 5432. Dentro de docker-compose, el contenedor `app` NO usa este valor:
# docker-compose.yml compone su propia DATABASE_URL con el host interno
# de red "postgres" a partir de POSTGRES_DB/USER/PASSWORD.
POSTGRES_DB=mantenimiento_aulas
POSTGRES_USER=mantenimiento
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://mantenimiento:changeme@localhost:5432/mantenimiento_aulas

# Rol de mínimo privilegio con el que la app se conecta en tiempo de
# ejecución (ver docs/AUDITORIA.md): sin privilegios de superusuario y sin
# permiso de escritura sobre audit_log. El rol se crea en la migración
# 0002 sin contraseña; `src/db/migrate.ts` la fija a partir de este valor
# en cada arranque, así que solo hace falta cambiarla aquí para rotarla.
# Igual que con DATABASE_URL: "localhost" para herramientas de host,
# docker-compose compone la variante interna con el host "postgres".
POSTGRES_APP_PASSWORD=changeme-app
APP_DATABASE_URL=postgresql://app_runtime:changeme-app@localhost:5432/mantenimiento_aulas

# MinIO (almacenamiento S3 compatible)
# MINIO_ROOT_USER/PASSWORD solo los usa el contenedor de MinIO; la app
# accede al bucket con las credenciales S3_ACCESS_KEY/S3_SECRET_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mantenimiento-aulas
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme123

# IA (Gemini) — opcional. Si se omite, las funciones de IA se ocultan
# y el resto de la aplicación funciona con normalidad.
# GEMINI_API_KEY=

{
  "name": "mantenimiento-aulas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "tsx scripts/preview.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:excel": "tsx scripts/import-excel.ts",
    "db:verify": "bash scripts/db-verify.sh",
    "admin:user": "tsx scripts/admin-user.ts",
    "gen:keys": "tsx scripts/gen-keys.ts",
    "variables": "tsx scripts/variables.ts",
    "deploy": "bash scripts/deploy.sh",
    "init:plataforma": "bash scripts/init-plataforma.sh",
    "backup": "bash scripts/backup.sh",
    "smoke": "tsx scripts/smoke.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "worker:test": "node scripts/worker-test.mjs",
    "worker:periodos": "tsx scripts/worker-periodos.ts",
    "verify:all": "npm test && npm run typecheck && npm run check:contrast && npm run worker:periodos && npm run build && npm run smoke"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.2",
    "playwright": "^1.62.0",
    "postcss": "^8.5.6",
    "read-excel-file": "^5.8.8",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
